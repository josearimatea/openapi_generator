# Provider — openrouter | openai
OPENAPI_GEN_PROVIDER=openrouter

# OpenAI (used when OPENAPI_GEN_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# OpenRouter (used when OPENAPI_GEN_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional — OpenRouter attributes usage to an app when these are sent
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=openapi-generator

# Logging — DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# LLM — with provider=openrouter the model needs the vendor prefix
OPENAPI_GEN_MODEL=openai/gpt-5.6-luna
OPENAPI_GEN_TEMPERATURE=0
# none omits the parameter, leaving the model to reason as it does by default;
# low | medium | high ask for a given effort. Omitting beats disabling: the
# rules bank measured the disable flag giving worse answers than no flag at all.
OPENAPI_GEN_REASONING_EFFORT=none

# Qdrant (RAG is optional — if Qdrant is unreachable or the collection does
# not exist, the generator continues without RAG context)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=3gpp_rel18_28
